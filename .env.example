# Browser build (read by Vite at build time): where Friends/online rooms connect.
#   unset or empty              online play is hidden (static hosting without a room server)
#   same-origin                 the Node server that serves the page (npm run dev and the Dockerfile use this)
#   https://rooms.example.com   a separate room server; only its origin is used, and plain http only for localhost
# VITE_ROOM_SERVER_URL=same-origin

# Room server (read by server/index.ts at start): comma-separated browser origins allowed to connect
# from another site, e.g. a static build hosted elsewhere. Unset allows only pages whose origin host
# matches the request Host (same-origin; keep the Host header when proxying). Non-browser clients send no Origin.
# CORS_ORIGIN=https://game.example.com
